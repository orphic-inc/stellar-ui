{
  "name": "@stellar/ui",
  "version": "0.8.3",
  "description": "",
  "author": "ayan4m1 <andrew@bulletlogic.com>, Kyle O'Brien <obrienk@webbhost.net>",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "api:generate": "npx --no-install openapi-typescript src/types/openapi.json -o src/types/api.ts && npx --no-install prettier --write src/types/api.ts",
    "api:sync": "cp ../stellar-api/openapi.json src/types/openapi.json && npm run api:generate",
    "contract:check": "node scripts/check-contract-drift.mjs",
    "build": "cross-env NODE_ENV=production webpack",
    "clean": "rm -rf dist",
    "start": "cross-env NODE_ENV=development webpack serve",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version-consistency.mjs",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^8.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.55.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/dompurify": "^3.0.5",
    "classnames": "^2.3.2",
    "core-js": "^3.31.1",
    "dompurify": "^3.4.1",
    "katex": "^0.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.73.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.8.1",
    "reselect": "^5.0.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/core": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@babel/register": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^30.3.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-import-resolver-webpack": "^0.13.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^9.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^17.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "openapi-typescript": "^7.13.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.0.0",
    "postcss-scss": "^4.0.6",
    "prettier": "3.9.6",
    "sass": "^1.64.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-webpack-plugin": "^5.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^6.0.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^6.0.0"
  }
}
